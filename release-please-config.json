{
  "release-type": "simple",
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "package/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "sushi-config.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-list.json",
          "jsonpath": "$.list[0].version"
        }
      ]
    }
  }
}
